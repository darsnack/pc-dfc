#!/bin/bash
#SBATCH --job-name=pc-dfc                ### Name of the job
#SBATCH --ntasks=1                       ### Number of Tasks
#SBATCH --cpus-per-task=56               ### Number of CPUs per Task
#SBATCH --mem=160G                       ### Memory required
#SBATCH --partition=gpuq
#SBATCH --qos=default
#SBATCH --time=48:00:00
#SBATCH --gres=gpu:h100:1
#SBATCH --output=slurm-logs/%x_%A_%a.out ### Slurm Output file, %x is job name, %A is array job id, %a is array job index
#SBATCH --error=slurm-logs/%x_%A_%a.out  ### Slurm Error file, %x is job name, %A is array job id, %a is array job index

# potentially turn SLURM_ARRAY into a real array
SLURM_ARRAY=( $SLURM_ARRAY )
echo "SLURM_ARRAY: $SLURM_ARRAY"
echo "SLURM_ARRAY[1]: ${SLURM_ARRAY[1]}"
# activate environment
echo "PATH: $PATH"
# show state of gpus
echo "GPUS: $CUDA_VISIBLE_DEVICES"
# run command passed to slurm
echo "Running $@"
eval PYTHONFAULTHANDLER=1 XLA_PYTHON_CLIENT_PREALLOCATE=1 uv run $@
