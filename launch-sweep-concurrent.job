#!/bin/bash
#SBATCH --job-name=pc-dfc-sweep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32GB
#SBATCH --partition=gpuq
#SBATCH --qos=bio_ai
#SBATCH --time=48:00:00
#SBATCH --gres=gpu:h100:1
#SBATCH --output=slurm-logs/%x_%A.out
#SBATCH --error=slurm-logs/%x_%A.err

# Run a portion of a W&B sweep using multiple agents that share this job's
# single GPU. This is submitted as an array by launch-sweep.job.
#
# Usage:
#   launch-sweep.job sweeps/<sweep>.yaml <runs-per-gpu-job>
#
# launch-sweep.job creates the W&B sweep and exports SLURM_SWEEP_ID and NJOBS.
# Each array task consumes up to RUNS_PER_GPU_JOB sweep runs.

set -uo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 RUNS_PER_GPU_JOB" >&2
    exit 2
fi

RUNS_PER_GPU_JOB=$1
if ! [[ $RUNS_PER_GPU_JOB =~ ^[1-9][0-9]*$ ]]; then
    echo "RUNS_PER_GPU_JOB must be a positive integer." >&2
    exit 2
fi

if [[ -z ${SLURM_SWEEP_ID:-} || ! ${NJOBS:-} =~ ^[1-9][0-9]*$ ]]; then
    echo "SLURM_SWEEP_ID and a positive NJOBS must be exported by launch-sweep.job." >&2
    exit 1
fi

ARRAY_INDEX=${SLURM_ARRAY_TASK_ID:-0}
if ! [[ $ARRAY_INDEX =~ ^[0-9]+$ ]]; then
    echo "SLURM_ARRAY_TASK_ID must be a non-negative integer." >&2
    exit 1
fi

FIRST_RUN=$((ARRAY_INDEX * RUNS_PER_GPU_JOB))
REMAINING_RUNS=$((NJOBS - FIRST_RUN))
if (( REMAINING_RUNS <= 0 )); then
    echo "Array task ${ARRAY_INDEX} has no sweep runs assigned." >&2
    exit 1
fi
WORKERS=$RUNS_PER_GPU_JOB
if (( WORKERS > REMAINING_RUNS )); then
    WORKERS=$REMAINING_RUNS
fi

echo "Running sweep ${SLURM_SWEEP_ID}: array task ${ARRAY_INDEX} runs ${FIRST_RUN} through $((FIRST_RUN + WORKERS - 1)) with ${WORKERS} concurrent agents"
echo "GPU: ${CUDA_VISIBLE_DEVICES:-not set}"

# JAX normally reserves most of a GPU on first use.  Do not overwrite an
# explicit user setting, but make sharing the allocated GPU work by default.
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-false}"
export PYTHONFAULTHANDLER=1

mkdir -p slurm-logs

declare -a PIDS=()
declare -a WORKER_RUNS=()

for ((worker = 0; worker < WORKERS; worker++)); do
    log_file="slurm-logs/${SLURM_JOB_NAME:-pc-dfc-sweep}_${SLURM_JOB_ID:-local}_agent-${worker}.out"
    echo "Starting agent ${worker} for 1 run; log: ${log_file}"
    uv run wandb agent \
        --entity "mitra-ryan-kyle" \
        --project "pc-dfc" \
        --count 1 \
        "$SLURM_SWEEP_ID" >"$log_file" 2>&1 &
    PIDS[$worker]=$!
    WORKER_RUNS[$worker]=1
done

status=0
for ((worker = 0; worker < WORKERS; worker++)); do
    if ! wait "${PIDS[$worker]}"; then
        echo "Agent ${worker} failed after being assigned ${WORKER_RUNS[$worker]} run(s)." >&2
        status=1
    fi
done

exit "$status"
